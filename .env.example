# Workbench environment config
#
# Copy to .env and fill in any subset — the router pools whatever is present.
# Keys are read from this file or real environment variables (real env wins).
# They are never stored in the database or exposed via the API/dashboard.

# --- Tier A (fast, generous free tiers) ---
GROQ_API_KEY=          # console.groq.com — 30 RPM, 14.4K req/day
CEREBRAS_API_KEY=      # cloud.cerebras.ai — ~1M tokens/day (trial needs a card)
GOOGLE_API_KEY=        # aistudio.google.com
NVIDIA_API_KEY=        # build.nvidia.com — 40 RPM
MISTRAL_API_KEY=       # console.mistral.ai (~1B tokens/mo, phone verify)

# --- Tier B ---
OPENROUTER_API_KEY=    # openrouter.ai — free variants, 50 req/day (1K with $10 lifetime)
ZAI_API_KEY=           # z.ai
DASHSCOPE_API_KEY=     # modelstudio (Qwen)
DEEPINFRA_API_KEY=     # deepinfra.com — $5 free credit, then $0.03/M
SAMBANOVA_API_KEY=     # sambanova.ai

# --- Tier C ---
TOGETHER_API_KEY=      # api.together.ai
FIREWORKS_API_KEY=     # fireworks.ai
SILICONFLOW_API_KEY=   # cloud.siliconflow.cn
HYPERBOLIC_API_KEY=    # app.hyperbolic.ai
PERPLEXITY_API_KEY=    # perplexity.ai

# --- Worker mode ---
# Shell out to a real coding agent instead of plain LLM completion.
# {prompt} is replaced with a safely-quoted task prompt.
# WORKBENCH_WORKER_EXEC=claude -p "{prompt}"
# WORKBENCH_WORKER_EXEC=opencode run "{prompt}"

# --- Server ---
# WORKBENCH_API_KEY=        # require Bearer auth on /api/*
# WORKBENCH_WEBHOOK_URL=    # signed outbound events
# WORKBENCH_WEBHOOK_SECRET=
# PORT=3000
